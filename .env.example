# =========================================================
# HirePilot AI — Environment Configuration Example
# Copy this file to .env and fill in your real values.
# =========================================================

# ----- Application ----------------------------------------
APP_NAME="HirePilot AI"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/HirePilot_webapplication/public
APP_VERSION=1.3.0
APP_SECRET=CHANGE_ME_32_CHAR_RANDOM_STRING

# ----- Primary Database (MySQL) ---------------------------
# If MySQL is unreachable, HirePilot automatically falls back
# to embedded SQLite at storage/database/hirepilot.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hirepilot_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ----- AI Integration (Groq / Grok Compatible) ------------
AI_PROVIDER=groq
AI_API_KEY=your_grok_or_groq_api_key_here
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.3-70b-versatile
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.6

# ----- Email (SMTP / Log) ---------------------------------
MAIL_DRIVER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@hirepilot.ai
MAIL_FROM_NAME="HirePilot AI"

# ----- File Uploads ---------------------------------------
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=pdf,doc,docx
UPLOAD_PATH=storage/uploads

# ----- Live Job APIs (Fantastic.jobs + Apify LinkedIn) ------
FANTASTIC_JOBS_API_KEY=your_fantastic_jobs_api_key_here
FANTASTIC_JOBS_API_URL=https://data.fantastic.jobs/v1/active-ats
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_LINKEDIN_ACTOR=bebity~linkedin-jobs-scraper

# ----- Session --------------------------------------------
SESSION_LIFETIME=7200
SESSION_SECURE=false
