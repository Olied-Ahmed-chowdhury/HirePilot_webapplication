# =========================================================
# HirePilot AI — Environment Configuration Example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =========================================================

# ----- Application ----------------------------------------
APP_NAME="HirePilot AI"
APP_ENV=development          # development | production
APP_DEBUG=true
APP_URL=http://localhost/HirePilot_webapplication/public
APP_VERSION=1.0.0
APP_SECRET=CHANGE_ME_32_CHAR_RANDOM_STRING

# ----- Database -------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hirepilot_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ----- AI Drafting (Grok / OpenAI-compatible) ------------
AI_PROVIDER=grok             # grok | openai | mock
AI_API_KEY=your_grok_or_openai_api_key_here
AI_API_URL=https://api.x.ai/v1/chat/completions
AI_MODEL=grok-beta
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.7

# ----- Email (SMTP) ---------------------------------------
MAIL_DRIVER=smtp             # smtp | log (log = preview-only, no real send)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=noreply@hirepilot.ai
MAIL_FROM_NAME="HirePilot AI"

# ----- Google OAuth ---------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost/HirePilot_webapplication/public/auth/google/callback

# ----- File Uploads ---------------------------------------
UPLOAD_MAX_SIZE=5242880      # 5 MB in bytes
UPLOAD_ALLOWED_TYPES=pdf,doc,docx
UPLOAD_PATH=storage/uploads

# ----- Session --------------------------------------------
SESSION_LIFETIME=7200        # seconds (2 hours)
SESSION_SECURE=false         # set true in production (HTTPS only)

